{
  "name": "t3-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Your WhatsApp companion for T3 Code.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/main.js",
    "pair": "node --import tsx src/main.ts pair",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "node --import tsx src/main.ts doctor",
    "history": "node --import tsx src/history-cli.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
